# ===========================================================================
# AMBIENTE DE DESENVOLVIMENTO LOCAL -- lido por start-dev.ps1
#
# Este arquivo NAO entra em commit (coberto por .env.dev e por .env.* no
# .gitignore). Os segredos aqui sao de desenvolvimento e nao valem nada fora
# desta maquina.
#
# Por que existe, separado do .env: o .env tem DATABASE_URL e REDIS_URL
# apontando para 5432/6379, que nao e onde os containers escutam. Aqui as URLs
# NAO sao declaradas -- o start-dev.ps1 as monta a partir das portas abaixo,
# para que porta e URL nao possam divergir.
# ===========================================================================

# --- Postgres (o docker-compose le estes nomes) -----------------------------
POSTGRES_DB=barbearia
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_PORT=5433

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6380

# --- Credenciais que a aplicacao usa para o mesmo banco ---------------------
DB_USERNAME=barbearia
DB_PASSWORD=troque-por-uma-senha-local

# --- Segredos de DESENVOLVIMENTO --------------------------------------------
# ENCRYPTION_KEY: e esta a chave com que o seed cifrou os dados do banco
# local. Trocar aqui torna ilegivel o que ja esta gravado -- nome e telefone
# dos agendamentos voltariam como lixo ou erro de decifragem.
ENCRYPTION_KEY=<64 caracteres hexadecimais -- a MESMA com que o banco foi semeado>
JWT_SECRET=<no minimo 32 caracteres>
JWT_REFRESH_SECRET=<no minimo 32 caracteres>
# Opcional em dev (o EnvironmentValidator so exige em prod). Fica declarado
# para o contrato da borda estar exercitavel localmente.
EDGE_TOKEN=<no minimo 32 caracteres; opcional em dev>

# --- Frontend e CORS --------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Evolution: SEMPRE o WireMock, nunca a instancia real -------------------
# A instancia de producao esta pareada com o WhatsApp do Jhonatan. A chave e o
# nome da instancia sao ficticios de proposito: o WireMock aceita qualquer
# coisa, e o que se verifica e o que o Java ENVIA.
EVOLUTION_API_URL=http://localhost:8089
EVOLUTION_API_KEY=chave-ficticia-de-desenvolvimento
EVOLUTION_INSTANCE_NAME=instancia-de-teste
BARBER_PHONE=5522999990000

# --- Portas dos processos locais --------------------------------------------
APP_PORT=8081
WIREMOCK_PORT=8089
WIREMOCK_VERSION=3.9.1
