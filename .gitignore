# --- Build ------------------------------------------------------------------
target/
build/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/
.mvn/wrapper/maven-wrapper.jar

# --- Segredos ---------------------------------------------------------------
.env
.env.*
!.env.example
# O .env.dev ja cai em `.env.*`; esta linha e explicita de proposito, para que
# quem leia nao precise deduzir que o glob o cobre.
.env.dev
# Os `.example` sao modelos sem segredo e PRECISAM ser versionados -- sem esta
# excecao o `.env.*` acima os engoliria junto com os arquivos reais.
!.env.dev.example

# --- Ambiente local do start-dev.ps1 ----------------------------------------
# Logs, PIDs e os mappings do WireMock. Tudo recriavel; nada versionado.
.dev-run/

# --- Dumps de banco ---------------------------------------------------------
# Um dump revela a estrutura do banco de producao. As migrations ficam
# versionadas em src/main/resources/db/migration; dumps na raiz, nunca.
/*.sql
*.dump
*.sql.gz

# --- Logs -------------------------------------------------------------------
*.log
logs/

# --- IDE --------------------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr
.vscode/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Sistema operacional ----------------------------------------------------
.DS_Store
Thumbs.db

# --- Gerado pelo Spring Initializr ------------------------------------------
HELP.md
