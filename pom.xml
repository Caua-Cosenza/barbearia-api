<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.cauacosenza</groupId>
	<artifactId>barbearia-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>barbearia-api</name>
	<description>API de agendamento da Barbearia Jhonatan Correa</description>

	<properties>
		<java.version>21</java.version>
		<!-- Versoes nao gerenciadas pelo BOM do Spring Boot 4.1.2 -->
		<jjwt.version>0.13.0</jjwt.version>
		<bucket4j.version>8.10.1</bucket4j.version>
		<jacoco.version>0.8.15</jacoco.version>
		<archunit.version>1.5.1</archunit.version>
		<pitest.version>1.30.1</pitest.version>
		<pitest.junit5.version>1.2.3</pitest.junit5.version>
		<!-- DEFAULTS ou STRONGER; sobrescreva com -Dpitest.mutators=STRONGER. -->
		<pitest.mutators>DEFAULTS</pitest.mutators>
		<pitest.threads>16</pitest.threads>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- JWT: jjwt-api em compile, impl e jackson em runtime (padrao recomendado pelo projeto) -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Rate limit distribuido sobre Redis -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-redis</artifactId>
			<version>${bucket4j.version}</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ===== test ===== -->
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			ArchUnit: as invariantes de arquitetura viram teste.
			Ver ArchitectureTest para o que cada regra protege.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				Mutation testing com o PIT.

				NAO roda no `verify`: o plugin nao e ligado a nenhuma fase do
				ciclo de vida, e so e executado quando invocado de proposito
				(`./mvnw pitest:mutationCoverage`). Mutation testing custa
				ordens de grandeza mais do que a suite normal.

				COMPATIBILIDADE: pitest-junit5-plugin 1.2.3 e compilado contra
				o JUnit Platform 1.9.2, e este projeto usa o 6.0.3 (Spring
				Boot 4 / JUnit 6). A combinacao foi verificada na pratica
				antes de ser fixada aqui, e funciona com pitest 1.30.1: o
				relato de "0% de cobertura" do issue #113 do plugin e de uma
				versao bem anterior do pitest (1.22.1).
			-->
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>${pitest.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>${pitest.junit5.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<!--
						Escopo deliberado. Mutante em classe de configuracao
						ou em DTO e ruido: nao ha logica para quebrar, e o
						score cai por causa de getters que nenhum teste
						chama diretamente.
					-->
					<targetClasses>
						<param>com.cauacosenza.barbearia.domain.*</param>
						<param>com.cauacosenza.barbearia.security.*</param>
						<param>com.cauacosenza.barbearia.service.*</param>
					</targetClasses>
					<excludedClasses>
						<!-- Entities: getters/setters do Lombok e callbacks de JPA. -->
						<param>com.cauacosenza.barbearia.domain.entity.*</param>
						<!-- Eventos de dominio: records, so transportam dado. -->
						<param>com.cauacosenza.barbearia.domain.event.*</param>
						<!-- Excecoes: mensagem e status, sem logica. -->
						<param>com.cauacosenza.barbearia.domain.exception.*</param>
						<!-- Codigo gerado e classes sinteticas. -->
						<param>*$*Builder</param>
						<param>*_$$_*</param>
					</excludedClasses>

					<!--
						Guardas de nulo que o caminho vivo nao alcanca.

						`MensagensDeWhatsApp.somenteDigitos` e
						`SlotQueryMapper.parseHora` comecam com um `if` de
						nulo que nenhuma entrada real dispara: o record
						`ChatMessage` recusa telefone nulo na construcao, e as
						colunas de hora sao NOT NULL no banco. Remover essas
						guardas gera mutante que sobrevive, e escrever teste
						para mata-lo seria cobrir caminho morto: custo de
						manutencao permanente sem proteger comportamento que
						alguem usa.

						PRECO DESTA EXCLUSAO, para ficar registrado: o PIT nao
						sabe suprimir um mutante isolado, so o metodo inteiro.
						Cada um destes tem tambem UM mutante legitimamente
						morto (o parse em si, e o retorno de somenteDigitos),
						e esses saem da conta junto. Ou seja, a exclusao
						melhora o numero e perde um pouco de sinal: foi uma
						escolha consciente, nao um efeito colateral.
					-->
					<excludedMethods>
						<param>somenteDigitos</param>
						<param>parseHora</param>
					</excludedMethods>

					<!--
						Quais testes o PIT usa para matar os mutantes. O
						default inclui TUDO: e o numero honesto, e leva horas,
						porque cada minion do PIT sobe o contexto do Spring e
						os containers do Testcontainers.

						Para a medicao rapida existe o perfil
						`pitest-rapido`, no fim deste arquivo.

						CUIDADO: cada `param` e um glob INTEIRO. Varios
						padroes exigem varios `param`. Uma lista separada por
						virgula dentro de um unico `param` vira um glob
						literal que nao casa com nada, e o PIT reporta
						"0 tests examined" com 100% de NO_COVERAGE: facil de
						confundir com incompatibilidade de versao.
					-->
					<targetTests>
						<param>com.cauacosenza.barbearia.*</param>
					</targetTests>

					<threads>${pitest.threads}</threads>
					<mutators>
						<param>${pitest.mutators}</param>
					</mutators>
					<outputFormats>
						<param>XML</param>
						<param>HTML</param>
					</outputFormats>
					<!--
						Sem limite de score: esta configuracao MEDE, nao
						reprova o build. Transformar mutation score em
						criterio de falha antes de saber onde estao os
						buracos faria o time perseguir o numero em vez do
						problema.
					-->
					<failWhenNoMutations>false</failWhenNoMutations>
					<timestampedReports>false</timestampedReports>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Mutation testing rapido: so os testes PUROS, sem Spring e sem
			Testcontainers.

				./mvnw -Ppitest-rapido pitest:mutationCoverage

			Roda em segundos em vez de horas. O preco e que tudo que so e
			coberto por teste de integracao aparece como NO_COVERAGE, e NAO
			como SURVIVED: sao coisas diferentes (ninguem testou vs. o teste
			nao percebeu) e nao devem ser somadas na leitura do relatorio.

			Vale para medir o que importa mais: SlotCalculator, CryptoService,
			JwtService, CookieFactory, SlotQueryMapper e MensagensDeWhatsApp
			tem teste puro e aparecem com numero confiavel aqui.
		-->
		<profile>
			<id>pitest-rapido</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<configuration>
							<targetTests>
								<param>com.cauacosenza.barbearia.domain.rules.*</param>
								<param>com.cauacosenza.barbearia.security.*</param>
								<param>com.cauacosenza.barbearia.service.*</param>
								<param>com.cauacosenza.barbearia.integration.EvolutionApiClientTest</param>
								<param>com.cauacosenza.barbearia.integration.LogsNaoVazamPiiTest</param>
								<param>com.cauacosenza.barbearia.integration.EquivalenciaComONodeTest</param>
							</targetTests>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
