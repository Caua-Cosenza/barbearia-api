<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.cauacosenza</groupId>
	<artifactId>barbearia-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>barbearia-api</name>
	<description>API de agendamento da Barbearia Jhonatan Correa</description>

	<properties>
		<java.version>21</java.version>
		<!-- Versoes nao gerenciadas pelo BOM do Spring Boot 4.1.2 -->
		<jjwt.version>0.13.0</jjwt.version>
		<bucket4j.version>8.10.1</bucket4j.version>
		<jacoco.version>0.8.15</jacoco.version>
		<archunit.version>1.5.1</archunit.version>
		<pitest.version>1.30.1</pitest.version>
		<pitest.junit5.version>1.2.3</pitest.junit5.version>
		<!-- DEFAULTS ou STRONGER; sobrescreva com -Dpitest.mutators=STRONGER. -->
		<pitest.mutators>DEFAULTS</pitest.mutators>
		<pitest.threads>16</pitest.threads>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- JWT: jjwt-api em compile, impl e jackson em runtime (padrao recomendado pelo projeto) -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Rate limit distribuido sobre Redis -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-redis</artifactId>
			<version>${bucket4j.version}</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ===== test ===== -->
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			ArchUnit: as invariantes de arquitetura viram teste.
			Ver ArchitectureTest para o que cada regra protege.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
				Mutation testing com o PIT.

				NAO roda no `verify`: o plugin nao e ligado a nenhuma fase do
				ciclo de vida, e so e executado quando invocado de proposito
				(`./mvnw pitest:mutationCoverage`). Mutation testing custa
				ordens de grandeza mais do que a suite normal.

				COMPATIBILIDADE: pitest-junit5-plugin 1.2.3 e compilado contra
				o JUnit Platform 1.9.2, e este projeto usa o 6.0.3 (Spring
				Boot 4 / JUnit 6). A combinacao foi verificada na pratica
				antes de ser fixada aqui, e funciona com pitest 1.30.1: o
				relato de "0% de cobertura" do issue #113 do plugin e de uma
				versao bem anterior do pitest (1.22.1).
			-->
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>${pitest.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>${pitest.junit5.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<!--
						Escopo deliberado. Mutante em classe de configuracao
						ou em DTO e ruido: nao ha logica para quebrar, e o
						score cai por causa de getters que nenhum teste
						chama diretamente.
					-->
					<targetClasses>
						<param>com.cauacosenza.barbearia.domain.*</param>
						<param>com.cauacosenza.barbearia.security.*</param>
						<param>com.cauacosenza.barbearia.service.*</param>
					</targetClasses>
					<excludedClasses>
						<!-- Entities: getters/setters do Lombok e callbacks de JPA. -->
						<param>com.cauacosenza.barbearia.domain.entity.*</param>
						<!-- Eventos de dominio: records, so transportam dado. -->
						<param>com.cauacosenza.barbearia.domain.event.*</param>
						<!-- Excecoes: mensagem e status, sem logica. -->
						<param>com.cauacosenza.barbearia.domain.exception.*</param>
						<!-- Codigo gerado e classes sinteticas. -->
						<param>*$*Builder</param>
						<param>*_$$_*</param>
					</excludedClasses>

					<!--
						Guardas de nulo que o caminho vivo nao alcanca.

						`MensagensDeWhatsApp.somenteDigitos` e
						`SlotQueryMapper.parseHora` comecam com um `if` de
						nulo que nenhuma entrada real dispara: o record
						`ChatMessage` recusa telefone nulo na construcao, e as
						colunas de hora sao NOT NULL no banco. Remover essas
						guardas gera mutante que sobrevive, e escrever teste
						para mata-lo seria cobrir caminho morto: custo de
						manutencao permanente sem proteger comportamento que
						alguem usa.

						PRECO DESTA EXCLUSAO, para ficar registrado: o PIT nao
						sabe suprimir um mutante isolado, so o metodo inteiro.
						Cada um destes tem tambem UM mutante legitimamente
						morto (o parse em si, e o retorno de somenteDigitos),
						e esses saem da conta junto. Ou seja, a exclusao
						melhora o numero e perde um pouco de sinal: foi uma
						escolha consciente, nao um efeito colateral.
					-->
					<excludedMethods>
						<param>somenteDigitos</param>
						<param>parseHora</param>
					</excludedMethods>

					<!--
						Quais testes o PIT usa para matar os mutantes. O
						default inclui TUDO: e o numero honesto, e leva horas,
						porque cada minion do PIT sobe o contexto do Spring e
						os containers do Testcontainers.

						Para a medicao rapida existe o perfil
						`pitest-rapido`, no fim deste arquivo.

						CUIDADO: cada `param` e um glob INTEIRO. Varios
						padroes exigem varios `param`. Uma lista separada por
						virgula dentro de um unico `param` vira um glob
						literal que nao casa com nada, e o PIT reporta
						"0 tests examined" com 100% de NO_COVERAGE: facil de
						confundir com incompatibilidade de versao.
					-->
					<targetTests>
						<param>com.cauacosenza.barbearia.*</param>
					</targetTests>

					<threads>${pitest.threads}</threads>
					<mutators>
						<param>${pitest.mutators}</param>
					</mutators>
					<outputFormats>
						<param>XML</param>
						<param>HTML</param>
					</outputFormats>
					<!--
						Sem limite de score: esta configuracao MEDE, nao
						reprova o build. Transformar mutation score em
						criterio de falha antes de saber onde estao os
						buracos faria o time perseguir o numero em vez do
						problema.
					-->
					<failWhenNoMutations>false</failWhenNoMutations>
					<timestampedReports>false</timestampedReports>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Mutation testing rapido: so os testes PUROS, sem Spring e sem
			Testcontainers.

				./mvnw -Ppitest-rapido pitest:mutationCoverage

			Roda em segundos em vez de horas. O preco e que tudo que so e
			coberto por teste de integracao aparece como NO_COVERAGE, e NAO
			como SURVIVED: sao coisas diferentes (ninguem testou vs. o teste
			nao percebeu) e nao devem ser somadas na leitura do relatorio.

			Vale para medir o que importa mais: SlotCalculator, CryptoService,
			JwtService, CookieFactory, SlotQueryMapper e MensagensDeWhatsApp
			tem teste puro e aparecem com numero confiavel aqui.
		-->
		<profile>
			<id>pitest-rapido</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<configuration>
							<targetTests>
								<param>com.cauacosenza.barbearia.domain.rules.*</param>
								<param>com.cauacosenza.barbearia.security.*</param>
								<param>com.cauacosenza.barbearia.service.*</param>
								<param>com.cauacosenza.barbearia.integration.EvolutionApiClientTest</param>
								<param>com.cauacosenza.barbearia.integration.LogsNaoVazamPiiTest</param>
								<param>com.cauacosenza.barbearia.integration.EquivalenciaComONodeTest</param>
							</targetTests>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			Mutation testing completo: usa TODOS os testes, inclusive os de
			integracao, para medir o que o `pitest-rapido` so consegue
			reportar como NO_COVERAGE.

				./mvnw -Ppitest-completo pitest:mutationCoverage

			EXIGE `-Dpitest.threads=1`:

				./mvnw -Ppitest-completo -Dpitest.threads=1 pitest:mutationCoverage

			POR QUE. Com mais de uma thread os minions compartilham o MESMO
			Postgres reusado, e o `@BeforeEach` de
			`AbstractPostgresIntegrationTest` da TRUNCATE nas tabelas. O
			TRUNCATE de um minion apaga os dados do outro no meio do teste, o
			teste do outro falha por contaminacao, e o PIT registra "mutante
			morto". Sao MORTES ESPURIAS, e elas INFLAM o score — o oposto de
			um falso negativo, e bem mais perigoso, porque parece boa noticia.

			Medido, nao suposto: com `threads=2` esta configuracao reportou
			288 mutantes, 275 mortos, score 95% e test strength 99%, e no meio
			disso deu como mortos os DOIS mutantes equivalentes de
			`PublicAppointmentService` — inclusive o da linha 278, que nao
			pode ser morto (ver o controle negativo abaixo). Com `threads=1`
			os mesmos equivalentes voltam a aparecer como sobreviventes.

			CONTROLE NEGATIVO PERMANENTE. O mutante de
			`PublicAppointmentService` linha 278 remove
			`setStatus(AppointmentStatus.PENDING)`, e o campo ja nasce PENDING
			em `Appointment.java:110`. Nenhum teste e capaz de distinguir as
			duas versoes, hoje ou algum dia: ele e equivalente por
			construcao. Se ele aparecer como MORTO em qualquer relatorio, a
			rodada esta contaminada e o numero nao vale — e o canario desta
			medicao. O outro equivalente conhecido e a linha 135, a guarda de
			data no passado, inalcancavel por HTTP.

			COMO LER `numberOfTestsRun` no mutations.xml. O numero significa
			coisas diferentes conforme o status do mutante. Para um mutante
			MORTO o PIT para no primeiro teste que mata, e dai tantos mutantes
			com n=1. Para um SOBREVIVENTE ele roda todos os testes que acredita
			cobrirem a linha, entao n e a contagem completa de cobertura.
			Consequencia pratica: num sobrevivente, n baixo demais em relacao a
			outros metodos do mesmo arquivo e sinal de ATRIBUICAO INCOMPLETA, e
			nao de codigo pouco exercitado.

			CODIGO DE INICIALIZACAO E MAL MEDIDO. O PIT atribui cobertura por
			execucao de teste. Codigo que roda na construcao do contexto do
			Spring executa uma vez, o contexto e cacheado, e os testes
			seguintes nunca pisam na linha: a cobertura fica atribuida so aos
			poucos testes que provocaram a criacao de cada contexto.

			Caso medido: `JwtService.chaveDe` com n=7, aproximadamente o numero
			de contextos distintos da suite, contra n=193 em
			`JwtCookieAuthenticationFilter` — mesmo arquivo de caminho de
			autenticacao, mesma suite. Os 5 sobreviventes de `chaveDe` eram
			"NAO MEDIDOS" e nao "nao protegidos": o teste que os mata
			(`AuthIntegrationTest.logar`, aplicado a mao) nunca foi rodado
			contra eles.

			Contraprova no mesmo relatorio: o `CryptoService` tambem decodifica
			chave na construcao, e os 5 mutantes dele MORRERAM, porque o
			`CryptoServiceTest` faz `new CryptoService(TEST_KEY)` no corpo do
			teste.

			A SAIDA e sempre a mesma: construir a classe diretamente num teste
			unitario, fora do contexto. Qualquer `@Configuration` ou construtor
			que entre no escopo do PIT no futuro cai nessa armadilha, e ela
			vale tambem para os mutantes MORTOS em codigo de boot — o
			denominador deles e igualmente irreal, porque foram mortos por um
			dos poucos testes que criam contexto.

			E NAO HABILITAR `junit.jupiter.execution.parallel.enabled`, pelo
			mesmo motivo: threads do JUnit dentro de uma JVM so dividem o
			mesmo Postgres tanto quanto minions de JVMs diferentes. O caminho
			para qualquer paralelismo aqui passa por isolar o SCHEMA do
			Postgres por JVM, como ja foi feito com a chave do Redis — o
			`RequisicaoDaBorda` sorteia um prefixo de endereco por processo, e
			foi isso que tirou o Redis desta lista.

			Cada minion ainda e uma JVM que sobe contexto do Spring, entao sem
			`testcontainers.reuse.enable=true` cada uma sobe tambem o seu
			proprio par Postgres+Redis: com o `pitest.threads=16` global, 16
			pares simultaneos levam a maquina a thrashing, timeout vira
			resultado de mutante e sobram containers orfaos.
		-->
		<profile>
			<id>pitest-completo</id>
			<properties>
				<pitest.threads>1</pitest.threads>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<configuration>
							<targetTests>
								<param>com.cauacosenza.barbearia.*</param>
							</targetTests>
							<!--
								O timeout default (4000ms + 1.25x o tempo do
								teste) nao cabe num teste que sobe contexto do
								Spring e espera container. Sem folga aqui,
								mutante sobrevivente e mutante com timeout
								ficam indistinguiveis no relatorio.
							-->
							<timeoutConstant>120000</timeoutConstant>
							<timeoutFactor>2.0</timeoutFactor>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
			O recorte minimo: so a classe onde mora o tratamento de
			concorrencia, so os testes que a exercitam.

				./mvnw -Ppitest-concorrencia pitest:mutationCoverage

			Existe porque a duvida que motivou a medicao e sobre UMA classe:
			sao 48 mutantes em vez de centenas, e cinco minutos em vez de
			meia hora. O `pitest-completo` tambem roda, desde que com
			`threads=1` (ver o aviso lá); este perfil ja fixa `threads` em 1
			pelo mesmo motivo, e nao depende de ninguem lembrar da flag.

			ATENCAO AO QUE ELE NAO MEDE. Nenhum mutador do PIT altera o tipo
			capturado num `catch`, e o 409 nao mora aqui: esta em
			`SlotIndisponivelException`, que `excludedClasses` tira do escopo.
			O metodo `gravar` gera exatamente UM mutante, e e um
			`NullReturnValsMutator`. Ou seja, este perfil mede o resto da
			classe; que as duas faces da corrida perdida viram 409 continua
			sendo questao de mutante aplicado a mao.
		-->
		<profile>
			<id>pitest-concorrencia</id>
			<properties>
				<pitest.threads>1</pitest.threads>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<configuration>
							<targetClasses>
								<param>com.cauacosenza.barbearia.service.PublicAppointmentService</param>
							</targetClasses>
							<targetTests>
								<param>com.cauacosenza.barbearia.integration.ConcurrentBookingHttpTest</param>
								<param>com.cauacosenza.barbearia.integration.PublicFlowIntegrationTest</param>
								<param>com.cauacosenza.barbearia.integration.NotificacaoDeAgendamentoTest</param>
								<param>com.cauacosenza.barbearia.controller.AppointmentControllerTest</param>
							</targetTests>
							<timeoutConstant>120000</timeoutConstant>
							<timeoutFactor>2.0</timeoutFactor>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
